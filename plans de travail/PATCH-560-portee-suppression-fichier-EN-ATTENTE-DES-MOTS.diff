+/**
+ * #560 (3 septembre 2026) — « du couple » = même élève, même production que le
+ * fichier. C'est EXACTEMENT ce que la suppression définitive emporte : originale,
+ * reprises, évaluation d'un fichier réimporté (tranché par Grégoire le 2 septembre ;
+ * le code le faisait déjà, l'écran ne le disait pas). Le prédicat est UNIQUE : la
+ * modale le lit pour annoncer, le filtre le lit pour détruire. Deux prédicats
+ * auraient pu diverger sans qu'aucun test ne le voie.
+ * @param {Object} objet - une évaluation, ou un autre fichier (mêmes champs)
+ * @param {Object} fichier - le fichier qu'on supprime
+ * @returns {boolean}
+ */
+function estDuCoupleDuFichier(objet, fichier) {
+    return !!(fichier && fichier.etudiantDA && fichier.productionId && objet &&
+        objet.etudiantDA === fichier.etudiantDA && objet.productionId === fichier.productionId);
+}
+
+/**
+ * #560 — ce qui part, et ce qui reste, quand ce fichier est supprimé pour de bon.
+ * Fonction PURE : on lui donne les listes, elle ne lit aucun magasin.
+ * @param {Object} fichier - le fichier à supprimer
+ * @param {Array} evaluations - les évaluations du trimestre (la source que la destruction filtre)
+ * @param {Array} fichiers - les fichiers connus, actifs et en corbeille (le fichier lui-même peut y être)
+ * @returns {{nbEvaluations: number, nbReprises: number, nbAutresFichiers: number}}
+ *   nbEvaluations : partent avec le fichier · nbReprises : parmi elles, celles qui
+ *   sont une reprise · nbAutresFichiers : RESTENT en place, sans plus d'évaluation.
+ */
+function decrirePorteeSuppressionFichier(fichier, evaluations, fichiers) {
+    const evalsDuCouple = (evaluations || []).filter(function(ev) { return estDuCoupleDuFichier(ev, fichier); });
+    const nbReprises = evalsDuCouple.filter(function(ev) { return !!ev.repriseDeId; }).length;
+    const nbAutresFichiers = (fichiers || []).filter(function(f) {
+        return f && f.id !== fichier.id && estDuCoupleDuFichier(f, fichier);
+    }).length;
+    return { nbEvaluations: evalsDuCouple.length, nbReprises: nbReprises, nbAutresFichiers: nbAutresFichiers };
+}
