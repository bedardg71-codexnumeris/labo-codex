#!/usr/bin/env bash
#
# Hook pré-push Labo Codex — Défense I du modèle de menaces.
#
# Exécute la suite de tests unit (Vitest) avant chaque push. Bloque le
# push si un test rouge — c'est la dernière ligne de défense avant que
# du code régressé atteigne origin.
#
# La sentinelle Playwright (intégration browser-real) est en seconde étape
# depuis le 18 août 2026 — mais elle est LUE ici, plus lancée (#533, 26 août).
#
# ⚠ POURQUOI CE RENVERSEMENT. `git push` ouvre la connexion vers le serveur
# AVANT d'exécuter ce hook. Tant que WebKit tournait ici, la session restait
# muette six minutes et GitHub la fermait : « Connection to github.com closed
# by remote host », suivi du verdict — juste, vert, et arrivé trop tard. Le
# push échouait alors que rien n'était cassé, ce qui pousse au --no-verify
# systématique, c'est-à-dire à la perte de la garde entière.
# La suite tourne désormais EN AMONT, via scripts/pousser.sh, et y dépose son
# verdict ; il ne reste ici qu'une lecture instantanée. Ce hook ne dépasse plus
# la durée de Vitest, une trentaine de secondes.
#
# Trois conditions tenues, parce qu'un hook inapplicable se contourne au lieu
# de servir :
#   1. le verdict n'est exigé QUE si le push touche du code observable au
#      navigateur (motif partagé : scripts/lot-observable.sh) — un push
#      documentaire ne demande rien ;
#   2. le jugement reste celui de `scripts/playwright-baseline.json`, le cliché
#      de la dette connue de #456 : seule une rougeur NOUVELLE bloque ;
#   3. il passe (fail-open) là où WebKit n'existe pas — tous les conteneurs.
#      Le Mac de Grégoire est le seul poste capable de rendre ce verdict.
#
# Pré-requis : `tests/node_modules/` installé. Si absent, le hook le
# détecte et passe (fail-open) — un développeur qui n'a pas installé
# les deps de test peut quand même pousser.
#
# Référence : docs/securite/TESTS-AUTOMATISES.md §7
# Désactivation totale (déconseillée) : `git push --no-verify`

set -u

ROUGE='\033[0;31m'
VERT='\033[0;32m'
JAUNE='\033[0;33m'
RAZ='\033[0m'

REPO_ROOT=$(git rev-parse --show-toplevel)
TESTS_DIR="$REPO_ROOT/tests"

# Si la suite n'est pas installée, on n'ennuie pas le développeur. Le hook
# pré-commit J reste actif, et la branche passera /ultrareview avant merge.
if [ ! -d "$TESTS_DIR/node_modules" ]; then
    printf "${JAUNE}⚠ Hook pré-push : tests/node_modules/ absent — suite Vitest skippée.${RAZ}\n"
    printf "  Pour activer : ${VERT}cd tests && npm install${RAZ}\n"
    exit 0
fi

printf "${VERT}→ Hook pré-push : exécution de la suite Vitest...${RAZ}\n"

# Exécution silencieuse sauf en cas d'échec.
SORTIE=$(cd "$TESTS_DIR" && npm run test:unit --silent 2>&1)
CODE=$?

if [ $CODE -ne 0 ]; then
    printf "\n${ROUGE}✗ Hook pré-push : la suite Vitest a échoué — push bloqué.${RAZ}\n\n"
    printf '%s\n' "$SORTIE"
    printf "\n${ROUGE}Corrige les tests rouges avant de pousser.${RAZ}\n"
    printf "Bypass d'urgence (déconseillé) : ${JAUNE}git push --no-verify${RAZ}\n"
    exit 1
fi

printf "${VERT}✓ Hook pré-push : suite Vitest verte.${RAZ}\n"

# ─────────────────────────────────────────────────────────────────────────────
# Étape 2 — sentinelle Playwright (#456)
# ─────────────────────────────────────────────────────────────────────────────

if [ "${SKIP_PLAYWRIGHT:-0}" = "1" ]; then
    printf "${JAUNE}⚠ Sentinelle Playwright : sautée (SKIP_PLAYWRIGHT=1).${RAZ}\n"
    exit 0
fi

# Quels fichiers ce push emporte-t-il ? git alimente stdin avec une ligne par
# ref : « <ref locale> <sha local> <ref distante> <sha distant> ».
#
# ⚠ Sur un push REJETÉ (non-fast-forward, branche en retard), git n'envoie
# AUCUNE ligne : la boucle ne tourne pas, et la sentinelle annonce « sans objet »
# alors qu'elle aurait dû partir. Observé le 18 août 2026, et d'abord pris pour
# un bug du filtrage. Ce n'en est pas un — le push échoue de toute façon, et la
# sentinelle fait son travail au push suivant, celui qui aboutit.
NUL='0000000000000000000000000000000000000000'
FICHIERS=''
LANCER=0
SHA_POUSSE=''

while read -r _ref_locale sha_local _ref_distante sha_distant; do
    # Suppression de branche : rien n'est poussé, rien à vérifier.
    [ "$sha_local" = "$NUL" ] && continue

    # Le verdict est rattaché à un commit précis : on retient celui qui part.
    SHA_POUSSE="$sha_local"

    if [ "$sha_distant" = "$NUL" ]; then
        # Branche neuve : aucune plage calculable. On lance — se taire ici
        # reviendrait à ne jamais vérifier une branche fraîche, ce qui est
        # exactement le cas où une régression passe.
        LANCER=1
        break
    fi

    FICHIERS="$FICHIERS$(git diff --name-only "$sha_distant" "$sha_local" 2>/dev/null)
"
done

# Le motif vit dans UN seul fichier, partagé avec scripts/pousser.sh : deux
# copies finiraient par diverger, et la divergence se verrait le jour où l'une
# laisserait passer un lot que l'autre aurait retenu.
. "$REPO_ROOT/scripts/lot-observable.sh"

if [ $LANCER -eq 0 ]; then
    if printf '%s' "$FICHIERS" | lot_observable; then
        LANCER=1
    fi
fi

if [ $LANCER -eq 0 ]; then
    printf "${VERT}✓ Sentinelle Playwright : sans objet (aucun fichier observable au navigateur dans ce push).${RAZ}\n"
    exit 0
fi

node "$REPO_ROOT/scripts/lire-verdict.mjs" "$SHA_POUSSE"
CODE_PW=$?

# 0 = verdict vert, rendu sur CE commit.
if [ $CODE_PW -eq 0 ]; then
    printf "${VERT}✓ Sentinelle Playwright : verdict vert à jour pour ce commit.${RAZ}\n"
    exit 0
fi

# 1 = rougeur NOUVELLE, la seule qui bloque au fond.
if [ $CODE_PW -eq 1 ]; then
    printf "\n${ROUGE}✗ Sentinelle Playwright : rougeur NOUVELLE au dernier passage — push bloqué.${RAZ}\n"
    printf "  Relance pour le détail : ${JAUNE}node scripts/verifier-playwright.mjs${RAZ}\n"
    exit 1
fi

# 2 = verdict impossible (WebKit absent, suite qui ne démarre pas). On laisse
# passer, mais on le DIT : un « impossible à juger » silencieux se confond avec
# un « tout va bien », et c'est comme ça que #456 est né.
if [ $CODE_PW -eq 2 ]; then
    printf "${JAUNE}⚠ Sentinelle Playwright : verdict impossible ici — push laissé passer.${RAZ}\n"
    printf "  Ces specs ne sont vérifiables que sur un poste avec WebKit.\n"
    exit 0
fi

# 3 = aucun verdict à jour. Ce push emporte du code observable au navigateur et
# personne n'a jugé CE commit. On refuse — mais en donnant le geste exact, parce
# qu'un refus sans issue se contourne au --no-verify et emporte toute la garde.
printf "\n${ROUGE}✗ Sentinelle Playwright : aucun verdict pour ce commit — push bloqué.${RAZ}\n\n"
printf "  Ce lot touche du code observable au navigateur, et WebKit n'a rien dit dessus.\n"
printf "  Le chemin normal fait les deux d'un geste :\n\n"
printf "      ${VERT}scripts/pousser.sh${RAZ}\n\n"
printf "  Ou, pour juger seulement (~4 min), puis repousser à la main :\n"
printf "      ${VERT}node scripts/verifier-playwright.mjs${RAZ}\n\n"
printf "  ${JAUNE}Ne lance PAS la suite depuis ce hook : la connexion au serveur est\n"
printf "  déjà ouverte, et six minutes de silence la font fermer (#533).${RAZ}\n"
exit 1
