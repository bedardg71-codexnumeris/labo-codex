# Netlify headers — règles de cache
# Source unique : évite que les navigateurs (Safari iPad en particulier)
# servent des versions périmées après un déploiement.

# HTML : toujours revalider (porte d'entrée de l'app)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# JavaScript : revalider à chaque accès (ETag gère l'efficacité)
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Feuilles de style : idem
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

# Source de vérité de la version : jamais cacher
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Données de configuration JSON : revalider
/*.json
  Cache-Control: public, max-age=0, must-revalidate

# Icônes SVG : peuvent être cachées (changent rarement, noms stables)
/icons/*
  Cache-Control: public, max-age=3600, must-revalidate

# Images (non-icônes) : cache modéré
/img/*
  Cache-Control: public, max-age=3600, must-revalidate
